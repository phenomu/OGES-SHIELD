# local config untuk Python orchestrator — SALIN ke .env lalu isi
# (gitignored, jangan commit .env; AI_ROUTER_API_KEY TIDAK BOLEH expose ke PHP/frontend)

# --- Database (shared dengan PHP app) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oges_shield
DB_USER=oges
DB_PASS=ganti_password_disini

# --- AI Router (9router self-hosted, OpenAI-compatible) ---
# Base URL tanpa trailing slash; endpoint: {AI_BASE_URL}/chat/completions
AI_BASE_URL=https://api.ate.my.id/v1
AI_ROUTER_API_KEY=ganti_dengan_key_9router_sendiri
# Model id WAJIB diverifikasi via GET {AI_BASE_URL}/models sebelum dipakai
AI_MODEL_PRIMARY=glm-5.3
AI_MODEL_FALLBACK=glm-5.2

# --- Orchestrator service ---
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8100
# Path ke binari Go (subfinder/httpx/nuclei/naabu) — kosong = cari di PATH
BIN_DIR=

# --- Safety limits (wajib, cegah infinite loop) ---
MAX_TOOL_CALLS_PER_PHASE=10
MAX_TIME_PER_PHASE_SECONDS=900
